*.py[cod]

# Self-play is source-controlled only at the orchestration/documentation level.
# Its buffers, trainer checkpoints, validation gates and snapshots are
# regenerated local artifacts (tens of GB) and must not be committed to GitHub.
# The deployable native exports (selfplay/models/*.native) ARE tracked since
# 2026-08-05 so model handoff between machines happens via git.
/selfplay/buffer/
/selfplay/cbuffer/
/selfplay/pbuffer/
/selfplay/card_buffer/
/selfplay/path_buffer/
/selfplay/card_models/
/selfplay/models/
!/selfplay/models/
/selfplay/models/*
!/selfplay/models/*.native
/selfplay/current/
/selfplay/cand/
/selfplay/gate/
/selfplay/logs/
/selfplay/*backup*/
/selfplay/status.txt
/selfplay/history.tsv
/selfplay/logs_run.out
build/pilot_val.csv
build/pilot_pol.csv

# Local multi-model agent workflow state.
/.ai/

# Local Serena project state (index, cache, and machine-specific configuration).
/.serena/

# CatBoost trainer output.
/catboost_info/