RUNS_PER_ITER=1000
SIMS=400
META_SIMS=300
GATE_SIMS=600
VNET_TREES=400
POLICY_TREES=100
META_RETRAIN_EVERY=2
POLICY_RETRAIN_EVERY=2
GATE_SEEDS=500
GATE_INITIAL=100
GATE_STEP=100
GATE_Z=2.58
WINDOW=5
META_WINDOW=10
POLICY_WINDOW=1
COMBAT=1
PROMOTE_MARGIN=0.5
# VALUE_MARGIN=-0.5 is a LATENCY allowance, not a quality standard. loop.sh
# honors a negative margin only with VALUE_MARGIN_LATENCY=1 (measured latency
# evidence) and otherwise clamps it to PROMOTE_MARGIN. This snapshot predates
# that gate; see operations/selfplay-loop.md (Issue 14).
VALUE_MARGIN=-0.5
VALUE_MARGIN_LATENCY=0
WIN_WEIGHT=0.1
META_MODE=floor
# Supported binary; CMake produces build/one_combat (a stale root ./one_combat.elf
# is not the built binary). Overridable via ONE_COMBAT_BIN/STS_BIN.
BIN=./build/one_combat
