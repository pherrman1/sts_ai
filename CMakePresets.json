{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-gcc-release",
      "displayName": "Linux/WSL GCC Release",
      "description": "Verified GNU C++/Unix Makefiles configuration for Linux and WSL.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux/WSL GCC Debug",
      "description": "GNU C++/Unix Makefiles configuration for assertion-dependent CTest checks.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc-build",
      "displayName": "Build Linux/WSL GCC Release",
      "configurePreset": "linux-gcc-release",
      "jobs": 0
    },
    {
      "name": "linux-gcc-debug-build",
      "displayName": "Build Linux/WSL GCC Debug",
      "configurePreset": "linux-gcc-debug",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc-test",
      "displayName": "Test Linux/WSL GCC Debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
