# Managed installs use tools/live_game_runtime.py and stable user-level paths.
# Explicit STS_MODEL_INSPECTOR_ADVISOR and STS_CTM_MODEL environment values win.
# The mod launches this as one direct ProcessBuilder argument; no shell is used.
advisor=/absolute/path/to/sts_ai/build/linux-gcc-debug/one_combat_advisor
ctmModel=/absolute/path/to/sts_ai/selfplay/models/combat_transition_near_full_except_smoke_v2.native
