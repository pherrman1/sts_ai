# Managed installs use tools/live_game_runtime.py and stable user-level paths.
# Explicit STS_MODEL_INSPECTOR_ADVISOR and STS_CTM_MODEL environment values win.
# The mod launches this as one direct ProcessBuilder argument; no shell is used.
advisor=/absolute/path/to/sts_ai/build/linux-gcc-debug/one_combat_advisor
ctmModel=/absolute/path/to/sts_ai/selfplay/models/combat_transition_near_full_except_smoke_v2.native
# Optional: repository tools directory containing render_combat_decision.py and render_ooc_mcts.py.
graphToolsDir=/absolute/path/to/sts_ai/tools
# Opt in to retaining live MCTS trees so the graph button can export them.
captureMctsGraphs=true
# Set false to keep action recommendations off the game UI while retaining diagnostics and graph export.
showActionRecommendations=true
# Hide the large advisor panel while keeping its graph and Silver controls available.
showAdvisorPanel=true
# Set false to hide the selected Silver card/action line inside the panel.
showSelectedActionSummary=true
# Optional Python executable used for graph export (default: python3).
python=python3
# Amber net search + explanation of out-of-combat decisions (tools/az_bench/amber_advisor.py, CPU only): point
# advisor at that file (or at a two-line wrapper that execs it with the Python that has torch) and the
# amber* keys at the wrapped advisor, a checkpoint and the az_bench_live module directory.
#advisor=/absolute/path/to/sts_ai/tools/az_bench/amber_advisor.py
#amberInnerAdvisor=/absolute/path/to/sts_ai/build/linux-gcc-release/one_combat_advisor
#amberCkpt=/absolute/path/to/ckpt.pt
#amberModuleDir=/absolute/path/to/sts_ai/build/linux-gcc-release
#amberThreads=2
#amberSims=64
# only = Amber answers out-of-combat requests alone; both = the wrapped advisor's OOC search runs too.
#amberOoc=only
# legacy = show the wrapped advisor's OOC ranking even when an Amber answer is there.
#oocSource=amber
# Set false to hide the Amber explanation box (upper right).
#showAmberExplanation=true
