+namespace {
+    // Research switch (default off): under Surrounded the 1.5x back attack follows the
+    // player's facing, which the next attack card changes. With the switch on, the block
+    // check uses the worst facing over the alive monsters instead of the current one.
+    bool rolloutSurroundedWorstFacing() {
+        static const bool on = [] {
+            const char *raw = std::getenv("STS_SILVER_ROLLOUT_SURROUNDED_FACING");
+            if (!raw || !*raw || std::string(raw) == "0") return false;
+            if (std::string(raw) == "1") return true;
+            throw std::runtime_error("STS_SILVER_ROLLOUT_SURROUNDED_FACING must be 0 or 1");
+        }();
+        return on;
+    }
+}
+
 int search::SilverRolloutAgent::getIncomingDamage(const BattleContext &bc) const {
+    if (rolloutSurroundedWorstFacing() && bc.player.hasStatus<PS::SURROUNDED>() && bc.monsters.monstersAlive > 1) {
+        BattleContext faced = bc;
+        int worst = 0;
+        for (int i = 0; i < bc.monsters.monsterCount; ++i) {
+            if (bc.monsters.arr[i].isDeadOrEscaped()) continue;
+            faced.player.lastTargetedMonster = static_cast<std::int8_t>(i);
+            worst = std::max(worst, incomingDamageAsFaced(faced));
+        }
+        return worst;
+    }
+    return incomingDamageAsFaced(bc);
+}
