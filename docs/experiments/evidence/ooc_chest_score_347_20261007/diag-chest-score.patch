     return splitMix64(seed ^ splitMix64(index));
 }
+// #347 diagnostic (STS_347_CHEST_SCORE=path): read-only scoring of a
+// treasure reward screen under the live leaf models, on detached copies.
+// Gold is taken in both arms so the relic is the only difference.
+void scoreChestRewards347(const GameContext &gc, const PathHistory &path,
+                          std::uint64_t seed, std::uint64_t index, const std::string &out) {
+    using RT = GameAction::RewardsActionType;
+    const auto leaf = [&](const GameContext &g, bool screen) {
+        auto opts = liveOptions;
+        opts.sampleNoncombat = false;
+        if (!screen) { opts.screenLeaf = false; opts.directLeaf = true; }
+        OocGameContextModel model(g, path, {}, opts, defaultOocMctsDependencies());
+        std::mt19937_64 rng(0);
+        return model.evaluateLeaf(0, rng);
+    };
+    const auto row = [&](const GameContext &g) {
+        nlohmann::json r{{"screen", static_cast<int>(g.screenState)},
+                         {"gold", g.gold}, {"relics", g.relics.size()}, {"x2b", leaf(g, false)}};
+        r["live"] = leaf(g, true);
+        return r;
+    };
+    const auto takeGold = [](GameContext &g) {
+        while (g.screenState == sts::ScreenState::REWARDS && g.info.rewardsContainer.goldRewardCount > 0
+               && GameAction(RT::GOLD, 0).isValidAction(g)) GameAction(RT::GOLD, 0).execute(g);
+    };
+    const auto leave = [](GameContext &g) {
+        if (g.screenState == sts::ScreenState::REWARDS && GameAction(RT::SKIP).isValidAction(g))
+            GameAction(RT::SKIP).execute(g);
+    };
+    nlohmann::json j{{"seed", seed}, {"idx", index}, {"floor", gc.floorNum}, {"act", gc.act},
+                     {"hp", gc.curHp}, {"maxHp", gc.maxHp}, {"gold", gc.gold},
+                     {"sapphireKey", gc.info.rewardsContainer.sapphireKey}};
+    for (int i = 0; i < gc.info.rewardsContainer.relicCount; ++i)
+        j["relics"].push_back(sts::relicNames[static_cast<int>(gc.info.rewardsContainer.relics[i])]);
+    j["root"] = row(gc);
+    auto leaveNow = detachedCopy(gc); leave(leaveNow); j["leave"] = row(leaveNow);
+    auto goldOnly = detachedCopy(gc); takeGold(goldOnly); j["gold_screen"] = row(goldOnly);
+    leave(goldOnly); j["gold_map"] = row(goldOnly);
+    auto withRelic = detachedCopy(gc); takeGold(withRelic);
+    while (withRelic.screenState == sts::ScreenState::REWARDS && withRelic.info.rewardsContainer.relicCount > 0
+           && GameAction(RT::RELIC, 0).isValidAction(withRelic)) GameAction(RT::RELIC, 0).execute(withRelic);
+    j["relic_screen"] = row(withRelic);
+    leave(withRelic); j["relic_map"] = row(withRelic);
+    std::ofstream o(out, std::ios::app);
+    o << j.dump() << '\n';
+    if (!o) throw std::runtime_error("STS_347_CHEST_SCORE write failed");
+}
 void configureLiveOocMcts() {
     const char *enabled = std::getenv("STS_OOC_MCTS");
     if (enabled && std::string(enabled) != "0" && std::string(enabled) != "1")
