+    // Research switch STS_SILVER_ROLLOUT_SURROUNDED_TARGET (default 0): under Surrounded the 1.5x
+    // back attack follows the player's facing, which each targeted attack sets. 1 keeps attacking the
+    // faced monster; 2 attacks the monster with the larger intent so it is the one faced.
+    int rolloutSurroundedTargetMode() {
+        static const int mode = [] {
+            const char *raw = std::getenv("STS_SILVER_ROLLOUT_SURROUNDED_TARGET");
+            if (!raw || !*raw || std::string(raw) == "0") return 0;
+            if (std::string(raw) == "1") return 1;
+            if (std::string(raw) == "2") return 2;
+            throw std::runtime_error("STS_SILVER_ROLLOUT_SURROUNDED_TARGET must be 0, 1 or 2");
+        }();
+        return mode;
+    }
+
+    int surroundedAttackTarget(const BattleContext &bc, int act) {
+        const int mode = rolloutSurroundedTargetMode();
+        if (mode == 0 || !bc.player.hasStatus<PS::SURROUNDED>() || bc.monsters.monstersAlive < 2) {
+            return -1;
+        }
+        const int faced = bc.player.lastTargetedMonster;
+        if (mode == 1) {
+            return faced >= 0 && faced < bc.monsters.monsterCount && bc.monsters.arr[faced].isTargetable() ? faced : -1;
+        }
+        int best = -1;
+        double bestDmg = -1;
+        for (int i = 0; i < bc.monsters.monsterCount; ++i) {
+            const auto &m = bc.monsters.arr[i];
+            if (!m.isTargetable()) continue;
+            double d;
+            if (m.pendingMoveRolls > 0 || m.pendingDirectMoveChoice != 0) {
+                d = 5.0 * act;
+            } else {
+                d = m.publicIncomingDamage(bc);
+                if (i != faced) d /= 1.5;  // frontal damage
+            }
+            if (d > bestDmg) { bestDmg = d; best = i; }
+        }
+        return best;
+    }
+
