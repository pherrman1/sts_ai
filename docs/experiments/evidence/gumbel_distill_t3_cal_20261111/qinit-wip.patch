+void search::SilverSearcher::netInit(Node &child, const Node &parentDecision) {
+    if (!nodeValueNet || child.hasNetValue || child.isRandomNode || child.state->outcome != Outcome::UNDECIDED
+            || parentDecision.simulationCount < valueNetParentMinVisits)
+        return;
+    child.netValue = nodeValueNet(*child.state);
+    child.hasNetValue = true;
