{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "architect": {
      "description": "Senior architect. Understands the task and writes a precise implementation plan without modifying the repository.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/prompts/architect.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git grep *": "allow",
          "git blame *": "allow",
          "python3 -I tools/ai_inspect.py *": "allow"
        }
      }
    },
    "implementer": {
      "description": "Implementation agent. Executes an approved plan, edits code and runs focused verification.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/prompts/implementer.md}",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "allow",
          "git commit *": "deny",
          "git push *": "deny",
          "git reset --hard *": "deny",
          "git clean *": "deny",
          "rm -rf *": "deny",
          "git restore *": "deny",
          "git checkout *": "deny",
          "git reset *": "deny"
        }
      }
    },
    "reviewer": {
      "description": "Senior adversarial reviewer. Reviews implementation correctness without modifying files.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git grep *": "allow",
          "python3 -I tools/ai_inspect.py *": "allow"
        }
      }
    },
    "reviewer_escalation": {
      "description": "Escalation auditor. Reviews high-risk cheap-reviewer passes and adjudicates bounded rejected-session recovery without modifying files.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "max",
      "prompt": "{file:./.opencode/prompts/reviewer.md}\n\n{file:./.opencode/prompts/reviewer-escalation.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git grep *": "allow",
          "python3 -I tools/ai_inspect.py *": "allow",
          "*&&*": "deny",
          "*||*": "deny",
          "*;*": "deny",
          "*|*": "deny",
          "*>*": "deny",
          "*<*": "deny"
        }
      }
    }
  }
}
